# DHAROHARCG - Smart Tourism & Cultural Heritage Platform for Chhattisgarh
# Environment Configuration Template
# Problem Statement ID: 26204 | Theme: Travel & Tourism | Team Kshitij

# Application Mode
VITE_APP_NAME="DHAROHARCG"
VITE_APP_ENV="production"
VITE_ENABLE_DEMO_MODE=true

# AI Service Configuration (Optional: built-in heuristic fallback engine runs automatically)
AI_API_KEY=your_gemini_or_openai_api_key_here
AI_MODEL_NAME=gemini-1.5-pro

# Geospatial / Mapping Service (Optional: procedural 3D WebGL engine runs offline)
MAP_API_KEY=your_mapbox_or_google_maps_key_here

# Database Configuration (Optional: prototype uses reactive client storage)
DATABASE_URL="postgresql://user:password@localhost:5432/dharoharcg"
MONGODB_URI="mongodb+srv://cluster.mongodb.net/dharoharcg"
REDIS_URL="redis://localhost:6379"

# Payment Gateway (Mock Gateway active by default)
PAYMENT_GATEWAY_KEY=rzp_test_your_razorpay_key
PAYMENT_SECRET=your_razorpay_secret

# Digital Heritage Passport / Ledger (Mock verification active by default)
BLOCKCHAIN_RPC_URL="https://polygon-mumbai.g.alchemy.com/v2/demo"
BLOCKCHAIN_CONTRACT_ADDRESS="0x71C...49A"

# Authentication & Security
AUTH_SECRET="dharoharcg_sih_super_secret_jwt_key_2026"
SESSION_EXPIRY_DAYS=7
